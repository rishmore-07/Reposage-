# ────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ────────────────────────────────────────────────────────────────────────────

# Application environment: development | staging | production
APP_ENV=development

# Secret key used for JWT signing. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# JWT access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT refresh token expiry in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# ────────────────────────────────────────────────────────────────────────────
# DATABASE
# ────────────────────────────────────────────────────────────────────────────

# Async PostgreSQL DSN (used by SQLAlchemy AsyncSession)
DATABASE_URL=postgresql+asyncpg://reposage:reposage@localhost:5432/reposage

# Sync PostgreSQL DSN (used by Alembic migrations only)
DATABASE_SYNC_URL=postgresql+psycopg2://reposage:reposage@localhost:5432/reposage

# PostgreSQL credentials (used by docker-compose postgres service)
POSTGRES_USER=reposage
POSTGRES_PASSWORD=reposage
POSTGRES_DB=reposage

# ────────────────────────────────────────────────────────────────────────────
# REDIS
# ────────────────────────────────────────────────────────────────────────────

# Redis DSN (used by Celery broker and result backend)
REDIS_URL=redis://localhost:6379/0

# ────────────────────────────────────────────────────────────────────────────
# CELERY
# ────────────────────────────────────────────────────────────────────────────

# Celery broker URL (should match REDIS_URL for Redis broker)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend URL
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ────────────────────────────────────────────────────────────────────────────
# GITHUB APP
# ────────────────────────────────────────────────────────────────────────────

# GitHub App ID (from GitHub App settings)
GITHUB_APP_ID=

# GitHub App private key in PEM format (used for JWT authentication)
# For multi-line values in .env, use base64 encoding
GITHUB_PRIVATE_KEY=

# GitHub App webhook secret (used to verify HMAC signatures)
GITHUB_WEBHOOK_SECRET=

# GitHub OAuth App client ID (for user OAuth login)
GITHUB_CLIENT_ID=

# GitHub OAuth App client secret
GITHUB_CLIENT_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# AI / LLM (Future)
# ────────────────────────────────────────────────────────────────────────────

# AI embedding provider: gemini | openai
AI_EMBEDDING_PROVIDER=gemini

# Google Gemini API key
GEMINI_API_KEY=

# OpenAI API key (if using OpenAI embeddings)
OPENAI_API_KEY=

# ────────────────────────────────────────────────────────────────────────────
# VECTOR STORE (Future)
# ────────────────────────────────────────────────────────────────────────────

# Qdrant host
QDRANT_HOST=localhost

# Qdrant port
QDRANT_PORT=6333

# ────────────────────────────────────────────────────────────────────────────
# EMAIL (Future)
# ────────────────────────────────────────────────────────────────────────────

# SMTP host for transactional email
SMTP_HOST=

# SMTP port
SMTP_PORT=587

# SMTP user
SMTP_USER=

# SMTP password
SMTP_PASSWORD=

# From address for outbound emails
EMAIL_FROM=noreply@reposage.dev

# ────────────────────────────────────────────────────────────────────────────
# CORS
# ────────────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins for CORS
# In production, set this to your frontend domain only
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ────────────────────────────────────────────────────────────────────────────
# LOGGING
# ────────────────────────────────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log format: json | text (use json in production)
LOG_FORMAT=json

# ────────────────────────────────────────────────────────────────────────────
# FRONTEND (Vite)
# ────────────────────────────────────────────────────────────────────────────

# Backend API base URL (used by Vite proxy in dev, hardcoded in prod build)
VITE_API_BASE_URL=http://localhost:8000

# Application name displayed in UI
VITE_APP_NAME=RepoSage
