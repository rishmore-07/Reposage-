# Development image — includes dev dependencies and hot-reload
FROM python:3.12-slim

WORKDIR /app

# Install system libraries including build tools (needed for some dev deps)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency manifests
COPY pyproject.toml .

# Install all dependencies including dev extras
RUN pip install --upgrade pip && \
    pip install -e ".[dev]"

# Copy application source (bind-mounted in docker-compose for hot-reload)
COPY . .

EXPOSE 8000

# Development entrypoint with hot-reload
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
