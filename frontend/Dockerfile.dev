FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./
RUN npm ci

# Source is bind-mounted in docker-compose for hot-reload
COPY . .

EXPOSE 5173

# Dev server with hot-reload, bound to all interfaces for Docker
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
